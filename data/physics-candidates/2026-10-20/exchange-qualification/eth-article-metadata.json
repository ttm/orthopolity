{"data":{"id":"10.3929/ethz-b-000487415","type":"dois","attributes":{"doi":"10.3929/ethz-b-000487415","prefix":"10.3929","suffix":"ethz-b-000487415","identifiers":[{"identifier":"1520-6882","identifierType":"ISSN"},{"identifier":"0003-2700","identifierType":"ISSN"},{"identifier":"0003-2700","identifierType":"ISSN"},{"identifier":"10.1021/acs.analchem.0c04939","identifierType":"other"},{"identifier":"http://hdl.handle.net/20.500.11850/487415","identifierType":"uri"}],"alternateIdentifiers":[{"alternateIdentifierType":"ISSN","alternateIdentifier":"1520-6882"},{"alternateIdentifierType":"ISSN","alternateIdentifier":"0003-2700"},{"alternateIdentifierType":"ISSN","alternateIdentifier":"0003-2700"},{"alternateIdentifierType":"other","alternateIdentifier":"10.1021/acs.analchem.0c04939"},{"alternateIdentifierType":"uri","alternateIdentifier":"http://hdl.handle.net/20.500.11850/487415"}],"creators":[{"name":"Bachler, Simon","nameType":"Personal","givenName":"Simon","familyName":"Bachler","affiliation":[],"nameIdentifiers":[]},{"name":"Ort, Marion","nameType":"Personal","givenName":"Marion","familyName":"Ort","affiliation":[],"nameIdentifiers":[]},{"name":"Krämer, Stefanie-Dorothea","nameType":"Personal","givenName":"Stefanie-Dorothea","familyName":"Krämer","affiliation":[],"nameIdentifiers":[]},{"name":"Dittrich, Petra S.","nameType":"Personal","givenName":"Petra S.","familyName":"Dittrich","affiliation":[],"nameIdentifiers":[]}],"titles":[{"lang":"en-US","title":"Permeation Studies across Symmetric and Asymmetric Membranes in Microdroplet Arrays"}],"publisher":"American Chemical Society","container":{},"publicationYear":2021,"subjects":[],"contributors":[{"name":"ETH Zurich","affiliation":[],"contributorType":"DataManager","nameIdentifiers":[]},{"name":"ETH Zurich","affiliation":[],"contributorType":"HostingInstitution","nameIdentifiers":[]}],"dates":[{"date":"2026-02-09","dateType":"Accepted"},{"date":"2021-05-29","dateType":"Available"},{"date":"2021-05-31","dateType":"Available"},{"date":"2026-02-09","dateType":"Available"},{"date":"2021-03-30","dateType":"Issued"}],"language":"en","types":{"ris":"JOUR","bibtex":"article","citeproc":"article-journal","schemaOrg":"ScholarlyArticle","resourceType":"Journal Article","resourceTypeGeneral":"Other"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":["application/pdf"],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"},{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"lang":"en-US","description":"We investigated the permeation of molecules across lipid membranes on an open microfluidic platform. An array of droplet pairs was created by spotting aqueous droplets, dispersed in a lipid oil solution, onto a plate with cavities surrounded by a hydrophobic substrate. Droplets in two adjacent cavities come in contact and form an artificial lipid bilayer, called a droplet interface bilayer (DIB). The method allows for monitoring permeation of fluorescently tagged compounds from a donor droplet to an acceptor droplet. A mathematical model was applied to describe the kinetics and determine the permeation coefficient. We also demonstrate that permeation kinetics can be followed over a series of droplets, all connected via DIBs. Moreover, by changing the lipid oil composition after spotting donor droplets, we were able to create asymmetric membranes that we used to mimic the asymmetry of the cellular plasma membrane. Finally, we developed a protocol to separate and extract the droplets for label-free analysis of permeating compounds by liquid chromatography-mass spectrometry. Our versatile platform has the potential to become a new tool for the screening of drug membrane permeability in the future.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://www.research-collection.ethz.ch/handle/20.500.11850/487415","contentUrl":null,"metadataVersion":14,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2021-06-01T03:01:35.000Z","registered":"2021-06-01T03:01:36.000Z","published":"2021","updated":"2026-02-09T17:17:16.000Z"},"relationships":{"client":{"data":{"id":"ethz.e-coll","type":"clients"}},"provider":{"data":{"id":"stdp","type":"providers"}},"media":{"data":{"id":"10.3929/ethz-b-000487415","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}