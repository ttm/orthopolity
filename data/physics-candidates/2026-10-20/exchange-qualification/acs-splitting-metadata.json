{"files": [{"id": 26828510, "name": "ac0c04939_si_003.avi", "size": 16935712, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/26828510", "supplied_md5": "4baecf9c790ae8e38274a90f6a119762", "computed_md5": "4baecf9c790ae8e38274a90f6a119762", "mimetype": "video/x-msvideo"}], "folder_structure": {}, "authors": [{"id": 4786089, "full_name": "Simon Bachler", "first_name": "Simon", "last_name": "Bachler", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10306856, "full_name": "Marion Ort", "first_name": "Marion", "last_name": "Ort", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1594093, "full_name": "Stefanie D. Kra\u0308mer", "first_name": "Stefanie D.", "last_name": "Kra\u0308mer", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1322826, "full_name": "Petra S. Dittrich", "first_name": "Petra S.", "last_name": "Dittrich", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/media/Permeation_Studies_across_Symmetric_and_Asymmetric_Membranes_in_Microdroplet_Arrays/14219954", "download_disabled": false, "description": "We investigated the\npermeation of molecules across lipid membranes\non an open microfluidic platform. An array of droplet pairs was created\nby spotting aqueous droplets, dispersed in a lipid oil solution, onto\na plate with cavities surrounded by a hydrophobic substrate. Droplets\nin two adjacent cavities come in contact and form an artificial lipid\nbilayer, called a droplet interface bilayer (DIB). The method allows\nfor monitoring permeation of fluorescently tagged compounds from a\ndonor droplet to an acceptor droplet. A mathematical model was applied\nto describe the kinetics and determine the permeation coefficient.\nWe also demonstrate that permeation kinetics can be followed over\na series of droplets, all connected via DIBs. Moreover, by changing\nthe lipid oil composition after spotting donor droplets, we were able\nto create asymmetric membranes that we used to mimic the asymmetry\nof the cellular plasma membrane. Finally, we developed a protocol\nto separate and extract the droplets for label-free analysis of permeating\ncompounds by liquid chromatography\u2013mass spectrometry. Our versatile\nplatform has the potential to become a new tool for the screening\nof drug membrane permeability in the future.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 16935712, "created_date": "2021-03-16T00:13:47Z", "modified_date": "2023-06-02T14:02:54Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["microfluidic platform", "acceptor droplet", "lipid oil solution", "donor droplet", "DIB", "label-free analysis", "plasma membrane", "lipid bilayer", "permeation coefficient", "donor droplets", "permeation kinetics", "droplet interface bilayer", "Microdroplet Arrays", "compound", "droplet pairs", "Permeation Studies", "lipid membranes", "monitoring permeation", "lipid oil composition", "drug membrane permeability", "Asymmetric Membranes", "cavity"], "keywords": ["microfluidic platform", "acceptor droplet", "lipid oil solution", "donor droplet", "DIB", "label-free analysis", "plasma membrane", "lipid bilayer", "permeation coefficient", "donor droplets", "permeation kinetics", "droplet interface bilayer", "Microdroplet Arrays", "compound", "droplet pairs", "Permeation Studies", "lipid membranes", "monitoring permeation", "lipid oil composition", "drug membrane permeability", "Asymmetric Membranes", "cavity"], "categories": [{"id": 1, "title": "Biophysics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 915, "title": "Physical Sciences no