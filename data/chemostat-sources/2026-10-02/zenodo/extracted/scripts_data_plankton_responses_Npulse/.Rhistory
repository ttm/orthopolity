'Brachionus'="solid",
'Cephalodella'="solid",
'Lecane'="solid"),
breaks=bk, labels=lab)+
scale_shape_manual(name="",
values=c("Chlorella"=19,
'Monoraphidium'=19,
"Monoraphidium_Chlorella"=19,
"Chlamydomonas"=19,
