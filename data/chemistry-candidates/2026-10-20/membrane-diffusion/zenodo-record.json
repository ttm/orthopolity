{"created": "2026-02-21T02:05:47.132171+00:00", "modified": "2026-02-21T02:05:47.500566+00:00", "id": 17238337, "conceptrecid": "17238336", "doi": "10.5281/zenodo.17238337", "conceptdoi": "10.5281/zenodo.17238336", "doi_url": "https://doi.org/10.5281/zenodo.17238337", "metadata": {"title": "Automated Sampling Workflow for Long-Term Membrane Diffusion Testing Software, UV-Vis Spectra, Labware Designs, and SAXS", "doi": "10.5281/zenodo.17238337", "publication_date": "2026-02-20", "description": "<p>Software, hardware designs, and data for the automated diffusion testing workflow (OT2-ADT).&nbsp;</p>\n<ul>\n<li>Data Analysis:\n<ul>\n<li>''<strong>ADT_Analysis_Walkthrough.ipynb</strong>': jupyter notebook with explanations and examples for processing and analyzing the data collected using the ADT workflow</li>\n<li>'<strong>ADT_Data_Analysis_Blank.ipynb</strong>': Blank version of the '<strong>ADT_Analysis_Walkthrough'&nbsp;</strong>notebook</li>\n<li>'<strong>ADT_OT2_Analysis.py</strong>': python script used in the analysis notebooks for obtaining diffusion results from the UV-Vis data</li>\n</ul>\n</li>\n<li>'<strong>Membrane Diffusion Testing.zip</strong>': zip file containing all experimental data pertaining to the PEGDA-based hydrogel membranes tested using the workflow. Includes UV-Vis data and test records.</li>\n<li>'<strong>SAXS.zip</strong>': zip file containing the small angle x-ray scattering (SAXS) files used in determining the mesh sizes of the PEGDA-based hydrogel membranes. Includes raw and reduces scattering profiles, fitting results from the Broad Peak analysis, and a metadata file containing information about the samples used in the analysis</li>\n<li>'<strong>Labware.zip</strong>': zip file containing .step and .stl files for all custom 3D-printed hardware used in the ADT workflow.</li>\n</ul>", "access_right": "open", "creators": [{"name": "Benstead, Claire", "affiliation": "University of Washington", "orcid": "0000-0003-3872-9369"}, {"name": "Politi, Maria", "affiliation": "University of Washington", "orcid": "0000-0002-5815-3371"}, {"name": "Bergsman, David", "affiliation": "University of Washington", "orcid": "0000-0002-0141-6417"}, {"name": "Pozzo, Lilo", "affiliation": "University of Washington", "orcid": "0000-0001-7104-9061"}], "keywords": ["UV-Vis Spectra", "Small Angle X-Ray Scattering", "Automation", "Membrane Permeability", "Hydrogels"], "related_identifiers": [{"identifier": "10.1039/d5dd00523j", "relation": "isSupplementTo", "resource_type": "publication-article", "scheme": "doi"}], "language": "eng", "custom": {"code:codeRepository": "https://github.com/pozzo-research-group/OT2-ADT/tree/main", "code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}]}, "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "17238336"}}]}}, "title": "Automated Sampling Workflow for Long-Term Membrane Diffusion Testing Software, UV-Vis Spectra, Labware Designs, and SAXS", "links": {"self": "https://zenodo.org/api/records/17238337", "self_html": "https://zenodo.org/records/17238337", "preview_html": "https://zenodo.org/records/17238337?preview=1", "doi": "https://doi.org/10.5281/zenodo.17238337", "self_doi": "https://doi.org/10.5281/zenodo.17238337", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17238337", "reserve_doi": "https://zenodo.org/api/records/17238337/draft/pids/doi", "parent": "https://zenodo.org/api/records/17238336", "parent_html": "https://zenodo.org/records/17238336", "parent_doi": "https://doi.org/10.5281/zenodo.17238336", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17238336", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:17238337/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:17238337/sequence/default", "files": "https://zenodo.org/api/records/17238337/files", "media_files": "https://zenodo.or