# Private working material: external assessments, unpublished pilot data,
# raw snapshots. Findings are incorporated into docs/; the directory itself
# is deliberately not tracked.
.private/

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# Interactive viewer scratch output (regenerated on demand)
results/exploration/

# Large public chemostat bundle and its extracted R workspace (~193 MB together).
# Their checksums are retained in acquisition.json and archive-members.json;
# restore with `make restore-chemostat-bundle`.
data/chemostat-sources/2026-10-02/zenodo/scripts_data_plankton_responses_Npulse.zip
data/chemostat-sources/2026-10-02/zenodo/extracted/scripts_data_plankton_responses_Npulse/.RData

# Packaging build artefacts
*.egg-info/
build/
dist/

# Derived tables regenerated from large external downloads (e.g. HydroLAKES radii)
data/derived/

# Full HydroLAKES download and extracted geometries; restore from acquisition.json.
data/hydrolakes/2026-10-09/HydroLAKES_polys_v10_shp.zip
data/hydrolakes/2026-10-09/extracted/
results/lake-gyration-2026-10-09/implementation/data/

# HydroBASINS source archives remain local; restore from publisher URLs/digests.
data/hydrobasins/2026-10-09/raw/

# Complete regional earthquake sources; publisher URLs and hashes are tracked.
data/seismic-regional/2026-10-09/raw/

# Candidate catalogues for the next seismic design; receipts are tracked.
data/seismic-candidates/2026-10-10/raw/
